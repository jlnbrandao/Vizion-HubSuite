APP_NAME=Lanstar
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+asyncpg://lanstar:lanstar@localhost:5432/lanstar
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production-use-long-random-string
# Outside development, JWT_SECRET_KEY must be a strong secret of at least 32 characters
# (defaults like change-me-in-production are rejected).
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
