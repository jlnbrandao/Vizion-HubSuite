APP_NAME=Lanstar
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# App role (subject to FORCE RLS). After migration 0009, prefer lanstar_app.
DATABASE_URL=postgresql+asyncpg://lanstar_app:lanstar_app@localhost:5432/lanstar
# Owner / migrate role for Alembic + CREATE ROLE (defaults to DATABASE_URL if empty)
DATABASE_MIGRATE_URL=postgresql+asyncpg://lanstar:lanstar@localhost:5432/lanstar
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production-use-long-random-string
# Outside development, JWT_SECRET_KEY must be a strong secret of at least 32 characters
# (defaults like change-me-in-production are rejected).
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Outside development cookies default to Secure. Set false only for HTTP-only hosts.
# COOKIE_SECURE=false

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Demo seed password is allowed only in development unless explicitly overridden:
# SEED_ALLOW_INSECURE=true

# Comma-separated Host suffixes allowed for tenant subdomains
# IP form (universe.134.209.122.250) is always accepted.
# Outside development, default DB passwords (lanstar / lanstar_app) are rejected.
ALLOWED_TENANT_BASE_DOMAINS=localhost,lanstar.com.br,lanstar.local

# IAM platform
IAM_OIDC_ENABLED=true
IAM_MFA_ENABLED=true
IAM_MFA_REQUIRED_ROLES=ADMIN,PLATFORM
IAM_SCIM_ENABLED=true
IAM_FEDERATION_ENABLED=true
IAM_ABAC_ENABLED=true
MFA_TOKEN_EXPIRE_MINUTES=5
INVITATION_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_HOURS=1
# SMTP (empty = log tokens to stdout in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@lanstar.local
SMTP_USE_TLS=true
# OIDC AS RS256 keys (PEM). Empty = ephemeral development key.
OIDC_ISSUER_TEMPLATE=https://{tenant_slug}.{base_domain}
OIDC_JWT_PRIVATE_KEY_PEM=
OIDC_JWT_PUBLIC_KEY_PEM=

# Integration Hub — Fernet key material (empty = derive from JWT_SECRET_KEY)
INTEGRATION_SECRETS_KEY=
