APP_NAME=Vizion
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# App role (subject to FORCE RLS). After migration 0009, prefer vizion_app.
DATABASE_URL=postgresql+asyncpg://vizion_app:vizion_app@localhost:5432/vizion
# Owner / migrate role for Alembic + CREATE ROLE (defaults to DATABASE_URL if empty)
DATABASE_MIGRATE_URL=postgresql+asyncpg://vizion:vizion@localhost:5432/vizion
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-in-production-use-long-random-string
# Outside development, JWT_SECRET_KEY must be a strong secret of at least 32 characters
# (defaults like change-me-in-production are rejected).
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Outside development cookies default to Secure. Set false only for HTTP-only hosts.
# When Secure, the refresh cookie uses the __Host- prefix (Path=/, no Domain).
# COOKIE_SECURE=false

# HTTP security headers. HSTS defaults to on outside development — keep it off
# until TLS terminates in front of the API, otherwise browsers pin plain HTTP hosts.
SECURITY_HEADERS_ENABLED=true
# HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Audit retention, applied when `python -m scripts.prune_audit` runs (cron).
AUDIT_RETENTION_DAYS=365

# Demo seed password is allowed only in development unless explicitly overridden:
# SEED_ALLOW_INSECURE=true

# Comma-separated Host suffixes allowed for tenant subdomains
# IP form (universe.134.209.122.250) is always accepted.
# Outside development, default DB passwords (vizion / vizion_app) are rejected.
ALLOWED_TENANT_BASE_DOMAINS=localhost,openvizion.com,openvizion.local

# IAM platform
IAM_OIDC_ENABLED=true
IAM_MFA_ENABLED=true
IAM_MFA_REQUIRED_ROLES=ADMIN,PLATFORM
IAM_SCIM_ENABLED=true
IAM_FEDERATION_ENABLED=true
IAM_ABAC_ENABLED=true
MFA_TOKEN_EXPIRE_MINUTES=5
INVITATION_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_HOURS=1
# SMTP (empty = log tokens to stdout in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@openvizion.local
SMTP_USE_TLS=true
# OIDC AS RS256 keys (PEM). Empty = ephemeral development key.
OIDC_ISSUER_TEMPLATE=https://{tenant_slug}.{base_domain}
OIDC_JWT_PRIVATE_KEY_PEM=
OIDC_JWT_PUBLIC_KEY_PEM=

# Integration Hub — Fernet key material (empty = derive from JWT_SECRET_KEY)
INTEGRATION_SECRETS_KEY=

# Asaas billing (empty API key = UI works, charges return 503)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=
