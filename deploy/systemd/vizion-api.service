[Unit]
Description=Vizion API (uvicorn FastAPI)
Documentation=file:///opt/vizion/README.md
After=network-online.target vizion-infra.service
Wants=network-online.target
Requires=vizion-infra.service

[Service]
Type=simple
WorkingDirectory=/opt/vizion/backend
EnvironmentFile=-/opt/vizion/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sleep 3
ExecStart=/opt/vizion/backend/.venv/bin/uvicorn src.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 2 \
    --proxy-headers \
    --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
