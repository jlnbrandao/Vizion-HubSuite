[Unit]
Description=Lanstar infrastructure (PostgreSQL + Redis via Docker Compose)
Documentation=file:///opt/lanstar/README.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/lanstar
ExecStart=/usr/bin/docker compose up -d --remove-orphans postgres redis
ExecStop=/usr/bin/docker compose stop postgres redis
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
